# Copie para .env na sua máquina. Não commite o .env.
# Em produção (Render) estes valores vêm do painel ou do render.yaml.

DEBUG=1
SECRET_KEY=troque-esta-chave-no-ambiente
# Deixe vazio para usar o SQLite local (db.sqlite3).
# No Postgres: postgres://usuario:senha@host:5432/nome
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://seu-dominio.onrender.com
